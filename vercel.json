{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "carmatch.thothi.app"
        }
      ],
      "destination": "https://matchmotorsbr.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "carmatch.thothi.app"
        }
      ],
      "destination": "https://matchmotorsbr.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "https://carmatch-website.vercel.app/"
    },
    {
      "source": "/dashboard/",
      "destination": "https://carmatch-website.vercel.app/"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://carmatch-website.vercel.app/:path*"
    }
  ]
}
